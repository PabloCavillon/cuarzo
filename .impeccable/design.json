  "narrative": {
    "northStar": "Crystalline Precision",
    "overview": "The design system operates at the intersection of haute horlogerie, high-performance software engineering, and crystalline optical physics. Built specifically for elite engineering studios and precision desktop environments, it eschews noisy digital maximalism in favor of architectural quietude, strict optical alignment, and surgical clarity.\n\nThe aesthetic fuses **Hyper-Minimalist Technical Rigor** with **Refined Crystalline Glassmorphism**. Interfaces mimic precision-milled obsidian substrates layered with calibrated sapphire glass panels. Translucencies serve strict structural hierarchy rather than decorative vanity—guiding the engineer's eye through deep data hierarchies without fatigue. Every surface conveys quiet authority: weightless yet structural, uncompromisingly clean, and meticulously engineered.",
    "keyCharacteristics": [],
    "rules": [
      {
        "name": "La regla del dialecto acotado",
        "body": "Lo que sigue es una excepción de los CV. Nada de esto se traslada a la landing, y los CV no agregan colores propios.",
        "section": "components"
      }
    ],
    "dos": [],
    "donts": []
  }
