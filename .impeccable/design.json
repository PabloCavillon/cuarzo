      "html": "<div class=\"ds-btn-stage\"><a class=\"ds-btn\" href=\"#\">Contanos tu proyecto</a></div>",
      "css": ".ds-btn-stage{padding:1.5rem;background:#090b10;color:#f8fafc;font:400 .9375rem/1.375rem Geist,system-ui,sans-serif}.ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;min-height:2.75rem;padding:.5rem 1.25rem;border:0;border-radius:.25rem;background:#f8fafc;color:#090b10;font:600 .9375rem/1.375rem Geist,system-ui,sans-serif;text-decoration:none;cursor:pointer;transition:background-color 150ms ease-out,color 150ms ease-out,box-shadow 150ms ease-out}.ds-btn:hover{box-shadow:0 0 12px rgba(56,189,248,.4)}.ds-btn:focus-visible{outline:2px solid #38bdf8;outline-offset:2px}.ds-btn:disabled{opacity:.6;cursor:not-allowed}@media (prefers-reduced-motion:reduce){.ds-btn{transition:none}}"
    },
