      "css": ".ds-beacon-stage{padding:1.5rem;background:#090b10;color:#f8fafc;font:400 .9375rem/1.375rem Geist,system-ui,sans-serif}.ds-beacon-stage{display:flex;align-items:center;gap:.5rem;color:#38bdf8;font:400 .75rem/1rem 'JetBrains Mono',ui-monospace,monospace;letter-spacing:.02em}.ds-beacon{display:block;flex:none;width:.375rem;height:.375rem;border-radius:50%;background:#00f0ff;box-shadow:0 0 0 0 rgba(0,240,255,.5);animation:ds-ping 2s ease-out infinite}@keyframes ds-ping{to{box-shadow:0 0 0 .5rem rgba(0,240,255,0)}}@media (prefers-reduced-motion:reduce){.ds-beacon{animation:none}}"
