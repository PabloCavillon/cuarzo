      "html": "<div class=\"ds-lit-stage\"><a class=\"ds-lit\" href=\"#\"><h3 class=\"ds-lit-title\">E-commerce</h3><p class=\"ds-lit-text\">Con Mercado Pago y Andreani.</p></a></div>",
      "css": ".ds-lit-stage{padding:1.5rem;background:radial-gradient(18rem 12rem at 70% 40%,rgba(56,189,248,.2),transparent 70%),#090b10;color:#f8fafc;font:400 .9375rem/1.375rem Geist,system-ui,sans-serif}.ds-lit{position:relative;display:block;padding:1.25rem;color:inherit;text-decoration:none;background:rgba(19,24,34,.7);-webkit-backdrop-filter:blur(16px);backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,.07);border-radius:.5rem;transition:border-color 200ms ease-out,box-shadow 200ms ease-out}@media (max-width:767px){.ds-lit{-webkit-backdrop-filter:none;backdrop-filter:none;background:#131822}}.ds-lit::before{content:\"\";position:absolute;inset-inline:0;top:-1px;height:1px;background:linear-gradient(90deg,transparent,rgba(56,189,248,.5),transparent);opacity:.45;transition:opacity 200ms ease-out}.ds-lit:hover,.ds-lit:focus-visible{border-color:rgba(56,189,248,.35);box-shadow:0 12px 32px -4px rgba(0,0,0,.7),0 0 16px -2px rgba(56,189,248,.14)}.ds-lit:hover::before{opacity:1}.ds-lit:focus-visible{outline:2px solid #38bdf8;outline-offset:2px}.ds-lit-title{margin:0;font:500 1.5rem/1.875rem 'Space Grotesk',Geist,sans-serif;letter-spacing:-.015em}.ds-lit-text{margin:.5rem 0 0;color:#94a3b8}"
