      "html": "<div class=\"ds-nav-stage\"><header class=\"ds-nav\"><a class=\"ds-nav-brand\" href=\"#\"><svg width=\"11.8\" height=\"28\" viewBox=\"0 0 48 114\" fill=\"none\" stroke=\"#38bdf8\" stroke-width=\"3\" stroke-linejoin=\"bevel\" aria-hidden=\"true\"><path d=\"M24 2 46 30 41 104 24 112 7 104 2 30Z\"/><path d=\"M2 30 24 24 46 30M24 2V112M7 74 24 68 41 74\"/></svg><span>CUARZO</span></a><nav class=\"ds-nav-links\" aria-label=\"Principal\"><a href=\"#\">Servicios</a><a href=\"#\">Cómo trabajamos</a><a href=\"#\">Otros trabajos</a></nav><a class=\"ds-nav-cta\" href=\"#\">Hablemos</a></header></div>",
      "css": ".ds-nav-stage{padding:.75rem;background:radial-gradient(18rem 12rem at 70% 40%,rgba(56,189,248,.2),transparent 70%),#090b10;color:#f8fafc;font:400 .9375rem/1.375rem Geist,system-ui,sans-serif}.ds-nav{display:flex;align-items:center;justify-content:space-between;gap:1rem;max-width:90rem;height:3.5rem;margin-inline:auto;padding-inline:1rem .5rem;background:rgba(19,24,34,.7);-webkit-backdrop-filter:blur(16px);backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,.07);border-radius:.5rem;border-radius:.75rem}@media (max-width:767px){.ds-nav{-webkit-backdrop-filter:none;backdrop-filter:none;background:#131822}}.ds-nav a{color:inherit;text-decoration:none}.ds-nav-brand{display:flex;align-items:center;gap:.625rem;font:500 1.125rem/1.875rem 'Space Grotesk',Geist,sans-serif;letter-spacing:.14em}.ds-nav-links{display:flex;align-items:center;gap:1.75rem;white-space:nowrap}.ds-nav-links a{transition:color 150ms ease-out}.ds-nav-links a:hover{color:#38bdf8}.ds-nav a:focus-visible{outline:2px solid #38bdf8;outline-offset:2px}.ds-nav .ds-nav-cta{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;min-height:2.75rem;padding:.5rem 1.25rem;border:0;border-radius:.25rem;background:#f8fafc;color:#090b10;font:600 .9375rem/1.375rem Geist,system-ui,sans-serif;text-decoration:none;cursor:pointer;transition:background-color 150ms ease-out,color 150ms ease-out,box-shadow 150ms ease-out;min-height:2.5rem;white-space:nowrap}.ds-nav .ds-nav-cta:hover{box-shadow:0 0 12px rgba(56,189,248,.4)}@media (max-width:1279px){.ds-nav-links{display:none}}@media (prefers-reduced-motion:reduce){.ds-nav-links a,.ds-nav .ds-nav-cta{transition:none}}"
